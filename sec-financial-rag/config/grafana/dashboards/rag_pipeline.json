{
  "annotations": { "list": [] },
  "editable": true,
  "title": "SEC Financial RAG Data Pipeline",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Total Documents Ingested",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rag_documents_ingested_total)",
          "legendFormat": "Documents"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Vector Chunks Upserted",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rag_chunks_upserted_total)",
          "legendFormat": "Chunks"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ray Processing Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_ray_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Embedding Token Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(rag_embedding_tokens_total[5m])",
          "legendFormat": "Tokens / Sec"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
